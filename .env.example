# Telegram Bot API Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# SQLite database file path
DB_PATH=data/bot.db

# Temporary directory for media processing
TEMP_DIR=/tmp/stickbot

# Bot username (without @) - optional, will be auto-detected via getMe if omitted
BOT_USERNAME=your_bot_username

# Optional: Cloudflare Worker reverse proxy URL (e.g. https://my-tg-proxy.workers.dev)
TELEGRAM_API_SERVER=

# Optional: SOCKS5 or HTTP proxy URL (e.g. socks5://127.0.0.1:10808)
PROXY_URL=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
